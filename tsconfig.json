{
  // Type checking only (bin/typecheck). The build (esbuild) doesn't read this file, see
  // tsconfigRaw in tooling/build/esbuild.mjs.
  "compilerOptions": {
    "noEmit": true,

    // Not all of `strict` (which TypeScript 7 turns on by default) yet: src/ doesn't pass
    // noImplicitThis, useUnknownInCatchVariables and strictBindCallApply.
    "strict": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    // A callback's parameters must accept everything its caller passes.
    "strictFunctionTypes": true,

    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "preserve",
    // Source files are ES modules that export `api` and `install()` (see src/unpoly.ts).
    // Some unpoly-migrate files and the Bootstrap entries have no import or export. Checking them
    // as modules too gives each its own scope, so `const u = up.util` doesn't clash between files.
    "moduleDetection": "force",
    // Don't load @types packages of our dev dependencies (node, express, ...).
    "types": [],
    "skipLibCheck": true,
    // The build strips types from each file on its own (esbuild). Flag code that needs
    // whole-program information to emit, like re-exported types without `export type`.
    "isolatedModules": true,
    // Forbid TypeScript syntax that has runtime semantics (enum, namespace, parameter
    // properties), so stripping the types is all it takes to get JavaScript. That keeps us
    // independent of the tool that strips them.
    "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts"]
}
