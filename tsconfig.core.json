{
  // Type checking only (bin/typecheck). Checks Unpoly's core (src/unpoly/) on its own, with the
  // settings of tsconfig.json. unpoly-migrate and the Bootstrap entries are left out: core never
  // imports them, and must not use the API that unpoly-migrate adds (like
  // `up.migrate.deprecated()`). tsconfig.json checks all of src/ together, where unpoly-migrate's
  // declarations would hide such a use.
  "extends": "./tsconfig.json",
  "include": ["src/types/**/*.ts", "src/unpoly.ts", "src/unpoly/**/*.ts"]
}
