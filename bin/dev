#!/usr/bin/env node
// Control the dev environment (spec server + build watcher).
//   bin/dev [start]   run it in the foreground (Ctrl-C to stop)
//   bin/dev stop      stop a background env started by bin/test
//   bin/dev status    report whether it is running
import { runDevEnvForeground, stopDevEnv, isDevEnvRunning } from '../runner/dev_env.mjs'
import pc from 'picocolors'

const command = process.argv[2] || 'start'

if (command === 'start') {
  process.exit(await runDevEnvForeground())
} else if (command === 'stop') {
  if (stopDevEnv()) {
    console.log(pc.blue('Dev environment stopped.'))
    process.exit(0)
  }
  console.error(pc.red('No background dev environment found to stop.'))
  process.exit(1)
} else if (command === 'status') {
  // Exit 0 = running, 3 = not running (LSB "status" convention).
  if (await isDevEnvRunning()) {
    console.log(pc.green('Dev environment is running.'))
    process.exit(0)
  }
  console.log(pc.yellow('Dev environment is not running.'))
  process.exit(3)
} else {
  console.error('Usage: bin/dev [start|stop|status]')
  process.exit(2)
}
