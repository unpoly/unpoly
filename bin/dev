#!/usr/bin/env node
// Control the dev environment (build watcher + spec server + any sibling projects):
//   bin/dev [start]   run it in this terminal (Ctrl-C to stop)
//   bin/dev stop      stop a running environment
//   bin/dev status    report whether one is running
// All the logic lives in runner/dev_env.mjs.
import { runDevEnvForeground, stopDevEnv, runningDevEnvPid, lastBuildErrors } from '../runner/dev_env.mjs'
import { buildFailure } from '../runner/terminal/formatter.mjs'
import pc from 'picocolors'

const command = process.argv[2] || 'start'

if (command === 'start') {
  const pid = await runningDevEnvPid()
  if (pid) {
    console.log(pc.yellow(`A dev environment is already running (PID ${pid}). Stop with \`bin/dev stop\`.`))
    process.exit(0)
  }
  process.exit(await runDevEnvForeground())
} else if (command === 'stop') {
  const result = await stopDevEnv()
  if (result === 'stopped') {
    console.log(pc.blue('Dev environment stopped.'))
    process.exit(0)
  }
  if (result === 'foreign') {
    console.error(pc.red('A dev environment is running that bin/dev did not start. Stop it where you started it.'))
    process.exit(1)
  }
  console.error(pc.red('No dev environment is running.'))
  process.exit(1)
} else if (command === 'status') {
  // Exit 0 = running & building cleanly, 1 = running but the last build failed,
  // 3 = not running (LSB "status" convention).
  const pid = await runningDevEnvPid()
  if (!pid) {
    console.log(pc.yellow('Dev environment is not running.'))
    process.exit(3)
  }
  const errors = lastBuildErrors()
  if (errors) {
    console.log(pc.green(`Dev environment is running (PID ${pid}), but the latest build failed:`))
    process.stdout.write(buildFailure(errors))
    process.exit(1)
  }
  console.log(pc.green(`Dev environment is running (PID ${pid}).`))
  process.exit(0)
} else {
  console.error('Usage: bin/dev [start|stop|status]')
  process.exit(2)
}
