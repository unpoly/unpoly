#!/usr/bin/env node
const fs = require('fs')
const { execSync } = require('child_process')
const readline = require('readline')
const path = require('path')
const { globSync } = require('glob')
const colors = require('yoctocolors-cjs')

function getVersion() {
  const packageJsonPath = 'package.json'
  const packageJsonContent = fs.readFileSync(packageJsonPath, 'utf-8')
  const packageInfo = JSON.parse(packageJsonContent)
  if (!packageInfo.version) {
    throw new Error(`Cannot parse { version } from ${packageJsonPath}`)
  }
  return packageInfo.version
}

function isPreRelease() {
  return /rc|beta|pre|alpha/.test(getVersion())
}

function changelogPath() {
  const major = getVersion().split('.')[0]
  return `docs/changes/CHANGELOG_${major}.x.md`
}

function checkChangelog() {
  const changelog = fs.readFileSync(changelogPath(), 'utf-8')
  if (/^Unreleased\n-+$/m.test(changelog)) {
    throw new Error(`Rename the "Unreleased" heading in ${changelogPath()} to ${getVersion()}`)
  }
}

function run(command, optional = false) {
  console.log(colors.cyan('$ ' + command))
  try {
    execSync(command, { stdio: 'inherit' })
  } catch (error) {
    if (!optional) {
      throw new Error(`Error running command: ${command}`)
    }
  }
}

function gitTag() {
  return 'v' + getVersion()
}

function gitTagMessage() {
  return 'Version ' + getVersion()
}

function confirm(message) {
  return new Promise((resolve) => {
    const rl = readline.createInterface({
      input: process.stdin,
      output: process.stdout
    })
    rl.question(colors.yellow(`${message} [y/N] `), (answer) => {
      rl.close()
      if (answer.trim().toLowerCase() === 'y') {
        resolve()
      } else {
        console.log("Aborted.")
        process.exit(1)
      }
    })
  })
}

// Removes every build output, so we only publish what the production build writes. Removing
// only files that paths() doesn't match left a dev or CI build's maps of the unminified bundles
// (unpoly.js.map and friends) in dist/, which paths() matched and we published.
function clean() {
  console.log("Removing previous build outputs...")
  console.log()
  globSync('dist/unpoly*{.css,.js,.map,.gz}').forEach(filePath => {
    fs.unlinkSync(filePath)
  })
}

// A running dev environment writes to dist/ too. bin/build stops it, but only after clean(), so a
// dev rebuild in between could leave its source maps for us to publish. Stop it first.
async function stopDevEnv() {
  const { stopDevEnv } = await import('../tooling/dev_env.mjs')
  const { result, pid } = await stopDevEnv()
  if (result === 'stopped') {
    console.log(colors.yellow('Stopped the dev environment, since it writes to dist/ too. Restart it with bin/dev.'))
  } else if (result === 'wedged') {
    throw new Error(`The dev environment (PID ${pid}) would not stop. Stop it by hand, then release again.`)
  }
}

function build() {
  console.log("Compiling a fresh build...")
  console.log()
  run('bin/build')
  console.log()
}

async function confirmRelease() {
  console.log()

  console.log(colors.bgBlue(colors.white(`You are about to ${isPreRelease() ? 'PRE-release' : 'release'} Unpoly version ${getVersion()} to npm.`)))
  console.log()
  console.log("Before continuing, make sure the following tasks are done:")
  console.log()
  console.log("- Bump the version in package.json")
  console.log("- Run `npm install` to update version in package-lock.json")
  console.log(`- Update ${changelogPath()}`)
  console.log("- Commit and push changes")
  console.log("- Check that CI is green (https://github.com/unpoly/unpoly/actions)")
  if (!isPreRelease()) {
    console.log("- Publish a pre-release (e.g. 3.13.0-rc1) and upgrade at least one real app to it")
  }
  console.log("- Make sure you're logged into npm")
  console.log()
  console.log("Continuing will make a fresh build and publish a new version to npm.")
  console.log()
  await confirm("Continue now?")
}

function pushTag() {
  const tag = gitTag()
  const message = gitTagMessage()
  console.log()
  run(`git push origin :refs/tags/${tag}`, true)
  run(`git tag --annotate --force --message='${message}' ${tag} HEAD`)
  run(`git push -f origin ${tag}`)
  console.log()
}

async function publishToNpm() {
  const npmTag = isPreRelease() ? 'next' : 'latest'
  const stagingDir = 'tmp/npm-staging'

  fs.rmSync(stagingDir, { recursive: true, force: true })
  fs.mkdirSync(stagingDir, { recursive: true })
  console.log(`Building NPM package in ${stagingDir} ...`)
  console.log()

  paths().forEach(file => {
    fs.copyFileSync(file, path.join(stagingDir, path.basename(file)))
  })

  console.log("Package contents:")
  console.log()
  run(`ls -l ${stagingDir}`)
  console.log()

  await confirm("Do the package contents look good?")
  const oldCwd = process.cwd()
  process.chdir(stagingDir)
  run(`npm publish --tag ${npmTag}`)
  process.chdir(oldCwd)
  console.log()
}

function paths() {
  const globs = [
    'package.json',
    'dist/unpoly{.js,.js.map,.min.js,.min.js.map}',
    'dist/unpoly.es6{.js,.js.map,.min.js,.min.js.map}',
    'dist/unpoly{.css,.css.map,.min.css,.min.css.map}',
    'dist/unpoly-migrate{.js,.js.map,.min.js,.min.js.map}',
    'dist/unpoly-bootstrap{3,4,5}{.js,.js.map,.min.js,.min.js.map}',
    'dist/unpoly-bootstrap{3,4,5}{.css,.css.map,.min.css,.min.css.map}',
    'dist/README.md',
    'dist/CHANGELOG.md',
    'dist/LICENSE'
  ]
  return globs.flatMap((file) => globSync(file))
}

async function processRelease() {
  checkChangelog()
  await stopDevEnv()
  await clean()
  await build()
  await confirmRelease()
  await pushTag()
  await publishToNpm()
  console.log()
  console.log("Now remember to:")
  console.log()
  console.log("- Make a new release to unpoly-rails with the same version")
  console.log("- Update unpoly.com (unpoly-site) so users see the updated CHANGELOG and CDN link")
  console.log("- Post an announcement about the new release to GitHub Discussions")
  console.log("- Tweet a link to the CHANGELOG as @unpolyjs")
  console.log()
}

processRelease().catch(error => {
  console.error("Error during release:", error)
  process.exit(1)
})
