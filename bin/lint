#!/usr/bin/env node
// Lint src/, spec/ and tooling/ with Oxlint, and check api collisions and the API doc files.
// tooling/lint/run_lint.mjs explains the checks. Extra arguments are forwarded to Oxlint, so
// `bin/lint --fix` works.
import { runLint } from '../tooling/lint/run_lint.mjs'

process.exit(await runLint({ extraArgs: process.argv.slice(2) }))
