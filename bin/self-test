#!/usr/bin/env node
// Runs the runner's OWN unit tests (Node's test runner), not the browser specs.
// NO_COLOR keeps the output stable so the formatter tests can assert on plain text.
import { spawn } from 'node:child_process'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const projectRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')

// shell:true so the glob expands (Node's --test wants explicit file paths).
let child = spawn('node --test runner/test/*.test.mjs', {
  shell: true,
  stdio: 'inherit',
  cwd: projectRoot,
  env: { ...process.env, NO_COLOR: '1' },
})
child.on('exit', (code) => process.exit(code ?? 1))
