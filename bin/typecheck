#!/usr/bin/env node
// Type-check src/ with TypeScript 7, using the tsconfig.json in the project root.
// Extra arguments are forwarded to tsc, so `bin/typecheck --extendedDiagnostics` works.
//
// TypeScript 7 is installed as `typescript7`. The `typescript` package stays at 5.9,
// because ESLint (typescript-eslint) needs its compiler API, which TypeScript 7 doesn't ship.
// The build doesn't use TypeScript at all: esbuild strips the types.
// So `npx tsc` (node_modules/.bin/tsc) runs TypeScript 5.9, a different and slower checker.
import { spawn } from 'node:child_process'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const projectRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
const tscBin = path.join(projectRoot, 'node_modules', 'typescript7', 'bin', 'tsc')

let child = spawn(tscBin, ['--project', 'tsconfig.json', ...process.argv.slice(2)], { stdio: 'inherit', cwd: projectRoot })
child.on('exit', (code) => process.exit(code ?? 1))
