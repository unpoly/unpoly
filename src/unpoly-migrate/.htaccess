# These Apache directives are included in the .htaccess for unpoly.com (repo unpoly-site)

# Documents moved under /learn and /api in the docs rework 2026. Their old paths
# (/caching, /up.render) need no rule here: unpoly-site's .htaccess redirects every
# /foo to /learn/foo, else to /api/foo. Only renamed or removed pages go below.
# Never redirect from a path that is also a document's slug: that rule would never fire.

RedirectPermanent /a-up-dash /api/up-dash
RedirectPermanent /a-up-instant /api/up-instant
RedirectPermanent /a-up-preload /api/up-preload
RedirectPermanent /a.up-active /api/up-active
RedirectPermanent /form.up-active /api/up-active
RedirectPermanent /a.up-current /api/up-current
RedirectPermanent /up-nav-a.up-current /api/up-current
RedirectPermanent /input-up-validate /api/up-validate
RedirectPermanent /form-up-validate /api/up-validate
RedirectPermanent /a-up-back /api/up-back
RedirectPermanent /input-up-switch /api/up-switch
RedirectPermanent /select-up-switch /api/up-switch
RedirectPermanent /up.proxy /api/up.network
RedirectPermanent /up.layout /api/up.viewport
RedirectPermanent /up.layout.config /api/up.viewport.config
RedirectPermanent /up.dom /api/up.fragment
RedirectPermanent /up.dom.config /api/up.fragment.config
RedirectPermanent /up.flow /api/up.fragment
RedirectPermanent /up.syntax /api/up.script
RedirectPermanent /up.script.data /api/up.data
RedirectPermanent /up.bus /api/up.event
RedirectPermanent /up.bus.onEscape /api/up.event.onEscape
RedirectPermanent /up.params /api/up.Params

RedirectPermanent /up.cache /learn/caching
RedirectPermanent /a-up-follow /api/up-follow
RedirectPermanent /form-up-submit /api/up-submit
RedirectPermanent /a-up-target /api/up-follow
