# These Apache directives are included in the .htaccess for unpoly.com (repo unpoly-site)

# BEGIN URL MOVE (generated by unpoly-site script/url_move.rb, do not edit by hand)
# Documents moved under /learn and /api (docs rework 2026). One rule per old path.
#
# PERMANENT: /install and /skill are short URLs printed on slides and in talks.
# Never remove these two rules, even when the other old paths are retired.
RedirectMatch 301 ^/install/?$ /learn/install
RedirectMatch 301 ^/skill/?$ /learn/skill
#
# All other old paths.
RedirectMatch 301 ^/ETag/?$ /api/ETag
