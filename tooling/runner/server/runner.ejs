<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Jasmine Specs</title>

    <meta name="csp-nonce" content="specs-nonce">

    <link rel="stylesheet" href="/dist/jasmine.css">
    <link rel="stylesheet" href="/dist/specs.css">
    <link rel="stylesheet" href="/dist/unpoly.css">

    <script nonce="specs-nonce">
      window.specs = {}
      window.specs.config = <%- config.toJSONString() %>;
    </script>

    <% var dist = config.distFilenames() %>

    <script nonce="specs-nonce" src="/dist/<%- dist.jasmine %>"></script>

    <script nonce="specs-nonce" src="/dist/<%- dist.unpoly %>"></script>

    <script nonce="specs-nonce" src="https://code.jquery.com/jquery-3.6.0.js"></script>

    <% if (config.migrate) { %>
      <script nonce="specs-nonce" src="/dist/<%- dist.migrate %>"></script>
    <% } %>

    <script nonce="specs-nonce" src="/dist/<%- dist.specs %>"></script>
  </head>
  <body>
  </body>
</html>
